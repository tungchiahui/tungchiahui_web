# Create the real file with SOPS + age and keep only the encrypted form in version control.
# This schema contains placeholders, not usable production values.
web_env: |
  DATABASE_URL=postgresql://site_app_login:REPLACE@pgbouncer:6432/tungchiahui
  SITE_BASE_URL=https://www.tungchiahui.cn
  SITE_REVALIDATION_SECRET=REPLACE_WITH_AT_LEAST_32_CHARACTERS
  ASSET_S3_ENDPOINT=https://s3.example.invalid
  ASSET_S3_REGION=us-east-1
  ASSET_S3_BUCKET=REPLACE
  ASSET_S3_ACCESS_KEY_ID=REPLACE
  ASSET_S3_SECRET_ACCESS_KEY=REPLACE
  ASSET_S3_FORCE_PATH_STYLE=true
control_api_env: |
  DATABASE_URL=postgresql://site_control_api_login:REPLACE@pgbouncer:6432/tungchiahui
  CONTROL_OPERATOR_KEYS_JSON=[]
  CONTROL_GITHUB_OIDC_POLICY_JSON=[{"audience":"tungchiahui-control-api","capabilities":["status:read","infrastructure-operation:create","infrastructure-operation:read"],"environment":"production","issuer":"https://token.actions.githubusercontent.com","jwksUrl":"https://token.actions.githubusercontent.com/.well-known/jwks","ref":"refs/heads/main","repository":"tungchiahui/tungchiahui_web","workflowRef":"tungchiahui/tungchiahui_web/.github/workflows/deploy.yml@refs/heads/main"},{"audience":"tungchiahui-control-api","capabilities":["translation:dry-run","translation:execute","translation:read","translation:cancel"],"environment":"production","issuer":"https://token.actions.githubusercontent.com","jwksUrl":"https://token.actions.githubusercontent.com/.well-known/jwks","ref":"refs/heads/main","repository":"tungchiahui/tungchiahui_web","workflowRef":"tungchiahui/tungchiahui_web/.github/workflows/translation.yml@refs/heads/main"},{"audience":"tungchiahui-control-api","capabilities":["application-job:create","application-job:read"],"environment":"production","issuer":"https://token.actions.githubusercontent.com","jwksUrl":"https://token.actions.githubusercontent.com/.well-known/jwks","ref":"refs/heads/main","repository":"tungchiahui/tungchiahui_content","jobWorkflowRef":"tungchiahui/tungchiahui_web/.github/workflows/content-sync.yml@refs/heads/main"}]
deployment_registry_env: |
  DEPLOYMENT_REGISTRY_USERNAME=REPLACE_WITH_PACKAGE_READ_IDENTITY
  DEPLOYMENT_REGISTRY_TOKEN=REPLACE_WITH_PACKAGE_READ_ONLY_TOKEN
content_worker_env: |
  DATABASE_URL=postgresql://site_content_worker_login:REPLACE@pgbouncer:6432/tungchiahui
  GITHUB_CONTENT_REPOSITORY=tungchiahui/tungchiahui_content
  GITHUB_CONTENT_READ_TOKEN=
  SITE_REVALIDATION_SECRET=REPLACE_WITH_AT_LEAST_32_CHARACTERS
observability_env: |
  # Optional scoped external delivery; alert transitions are always structured stderr events.
  # OBSERVABILITY_ALERT_WEBHOOK_URL=https://alerts.example.invalid/tungchiahui
  # OBSERVABILITY_ALERT_WEBHOOK_BEARER_TOKEN=REPLACE_WITH_ALERT_ONLY_TOKEN
database_role_bootstrap_env: |
  DATABASE_ADMIN_URL=postgresql://tungchiahui:REPLACE@postgres:5432/tungchiahui
  SITE_APP_LOGIN_NAME=site_app_login
  SITE_APP_LOGIN_PASSWORD=REPLACE_WITH_AT_LEAST_32_CHARACTERS
  SITE_CONTENT_WORKER_LOGIN_NAME=site_content_worker_login
  SITE_CONTENT_WORKER_LOGIN_PASSWORD=REPLACE_WITH_AT_LEAST_32_CHARACTERS
  SITE_CONTROL_API_LOGIN_NAME=site_control_api_login
  SITE_CONTROL_API_LOGIN_PASSWORD=REPLACE_WITH_AT_LEAST_32_CHARACTERS
  SITE_MIGRATOR_LOGIN_NAME=site_migrator_login
  SITE_MIGRATOR_LOGIN_PASSWORD=REPLACE_WITH_AT_LEAST_32_CHARACTERS
database_migrate_env: |
  DATABASE_URL=postgresql://site_migrator_login:REPLACE@postgres:5432/tungchiahui
postgres_env: |
  POSTGRES_DB=tungchiahui
  POSTGRES_USER=tungchiahui
  POSTGRES_PASSWORD=REPLACE
  PGBACKREST_REPO1_CIPHER_PASS=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
backup_env: |
  PGBACKREST_REPO1_CIPHER_PASS=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
  BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_RECIPIENT
  BACKUP_S3_ENDPOINT=https://REPLACE.r2.cloudflarestorage.com
  BACKUP_S3_REGION=auto
  BACKUP_S3_BUCKET=REPLACE_OFFSITE_BACKUP_BUCKET
  BACKUP_S3_ACCESS_KEY_ID=REPLACE_BACKUP_ONLY_IDENTITY
  BACKUP_S3_SECRET_ACCESS_KEY=REPLACE
  BACKUP_S3_FORCE_PATH_STYLE=false
backup_age_identity: |
  AGE-SECRET-KEY-REPLACE
pgbouncer_userlist: |
  "site_app_login" "SCRAM-SHA-256$REPLACE"
  "site_control_api_login" "SCRAM-SHA-256$REPLACE"
  "site_content_worker_login" "SCRAM-SHA-256$REPLACE"
  "site_migrator_login" "SCRAM-SHA-256$REPLACE"
