# Server-side public base URL. This value is not a secret.
SITE_BASE_URL=http://localhost:3000
SITE_DEPLOYMENT_SHA=0000000000000000000000000000000000000000
# Shared only between content-worker and the internal Next.js revalidation endpoint.
# Use an injected secret of at least 32 characters outside local/test.
SITE_REVALIDATION_SECRET=

# Optional loopback-only local development port overrides. No production credential is required.
SITE_WEB_PORT=3000
SITE_POSTGRES_PORT=15432
SITE_PGBOUNCER_PORT=16432
SITE_S3_PORT=19090
SITE_CONTROL_API_PORT=18080
SITE_FAKE_DEPLOY_AGENT_PORT=18081
SITE_OPENRESTY_PORT=18443

# Phase 11 application asset identity. Local Docker Compose injects isolated dummy values;
# production values stay server-side and must be read-only for the application bucket.
ASSET_S3_ENDPOINT=
ASSET_S3_REGION=us-east-1
ASSET_S3_BUCKET=
ASSET_S3_ACCESS_KEY_ID=
ASSET_S3_SECRET_ACCESS_KEY=
ASSET_S3_FORCE_PATH_STYLE=true
ASSET_CDN_BASE_URL=https://cdn.tungchiahui.cn

# Primary recovery target (Production: same AList connection as ASSET_S3_*;
# the engine writes only under the fixed backups/ namespace).
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=true

# Independent off-site recovery target (Production: Cloudflare R2).
BACKUP_OFFSITE_S3_ENDPOINT=
BACKUP_OFFSITE_S3_REGION=auto
BACKUP_OFFSITE_S3_BUCKET=
BACKUP_OFFSITE_S3_ACCESS_KEY_ID=
BACKUP_OFFSITE_S3_SECRET_ACCESS_KEY=
BACKUP_OFFSITE_S3_FORCE_PATH_STYLE=false

# OPERATOR TEST ONLY — do not deploy this block to any production service.
# Phase 11 explicit non-production contract target for any S3-compatible implementation.
# Loaded only by `./site storage contract s3 --confirm S3-NON-PRODUCTION`; normal dev/test and
# production application runtime ignore these values.
S3_CONTRACT_ENVIRONMENT=non-production
S3_CONTRACT_ENDPOINT=
S3_CONTRACT_REGION=us-east-1
S3_CONTRACT_BUCKET=
S3_CONTRACT_ACCESS_KEY_ID=
S3_CONTRACT_SECRET_ACCESS_KEY=
S3_CONTRACT_FORCE_PATH_STYLE=true
S3_CONTRACT_CDN_BASE_URL=

# Phase 5 content-worker source identity. Public repositories need no token.
GITHUB_CONTENT_REPOSITORY=owner/repository
# Optional server-only read token for a private content repository; never grant write scopes.
GITHUB_CONTENT_READ_TOKEN=
# Durable PostgreSQL search-reindex polling remains opt-in for local development.
SEARCH_WORKER_POLLING_ENABLED=false

# Remote operator CLI. The default public control namespace is shown explicitly.
# Keep the Ed25519 private JWK outside the repository; only its file path belongs here.
SITE_CONTROL_API_URL=https://www.tungchiahui.cn
SITE_OPERATOR_KEY_ID=
SITE_OPERATOR_PRIVATE_KEY_PATH=

# deploy-agent only. The repository is non-secret; credentials, when required for a private
# registry, are injected only through the encrypted production deployment-registry.env file.
DEPLOYMENT_IMAGE_REPOSITORY=ghcr.io/tungchiahui/tungchiahui_web
DEPLOYMENT_REGISTRY_USERNAME=
DEPLOYMENT_REGISTRY_TOKEN=
