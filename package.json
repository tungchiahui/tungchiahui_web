{
  "name": "tungchiahui-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.23.0"
  },
  "scripts": {
    "build": "next build",
    "check:biome": "biome check .",
    "check:drizzle": "drizzle-kit check",
    "check:source": "tsx tools/quality/source-policy.ts",
    "db:generate": "drizzle-kit generate",
    "dev": "next dev",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "renovate:validate": "renovate-config-validator renovate.json",
    "site:check": "pnpm run check:biome && pnpm run check:source && pnpm run check:drizzle && pnpm run typecheck && pnpm run renovate:validate && pnpm run build",
    "site:test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:migration && pnpm run test:e2e:placeholder",
    "start": "next start",
    "test:e2e:placeholder": "tsx tools/quality/placeholder.ts e2e",
    "test:integration": "tsx tools/dev/test-stack.ts",
    "test:migration": "tsx tools/database/test-migrations.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1116.0",
    "@base-ui/react": "1.7.0",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.10",
    "lucide-react": "1.33.0",
    "next": "16.3.2",
    "next-intl": "4.13.7",
    "pg": "8.23.0",
    "pinyin-pro": "3.29.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-frontmatter": "5.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "unified": "11.0.5",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "drizzle-kit": "0.31.10",
    "jsdom": "30.0.1",
    "renovate": "44.39.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
